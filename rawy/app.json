{
  "expo": {
    "name": "Rawy",
    "slug": "rawy",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/rawy.jpg",
    "scheme": "rawy",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "icon": "./assets/images/home-icon.jpg",
      "infoPlist": {
        "UIBackgroundModes": ["audio"]
      }
    },
    "android": {
      "package": "com.kahlaafaq.rawy",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/home-icon.jpg",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": ["FOREGROUND_SERVICE", "FOREGROUND_SERVICE_MEDIA_PLAYBACK"]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/home-icon.jpg"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/rawy.jpg",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#ffffff"
          }
        }
      ],
      "expo-secure-store",
      "expo-web-browser",
      "expo-font",
      ["expo-audio", { "enableBackgroundPlayback": true }]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
